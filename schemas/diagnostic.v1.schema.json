{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-interface-kit:schema:diagnostic:v1",
  "title": "AIK diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "sourceRef"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
    },
    "severity": {
      "enum": ["info", "warning", "error"]
    },
    "sourceRef": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    }
  }
}
