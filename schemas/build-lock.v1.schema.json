{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-interface-kit:schema:build-lock:v1",
  "title": "AIK build lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputs",
    "toolchain",
    "options",
    "buildId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aik.build-lock.v1"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "overlay",
        "catalog",
        "assets"
      ],
      "properties": {
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "catalog": {
          "type": "null"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "sourceAdapter",
        "snapshotSchema",
        "core",
        "target",
        "artifactManifestSchema"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "sourceAdapter": {
          "type": "string",
          "minLength": 1
        },
        "snapshotSchema": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "artifactManifestSchema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "naming"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "naming": {
          "enum": [
            "plain",
            "bem"
          ]
        }
      }
    },
    "buildId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
