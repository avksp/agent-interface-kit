{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-interface-kit:schema:overlay:v1",
  "title": "AIK overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "aik.overlay.v1",
        "aik.pilot-overlay.v1"
      ]
    },
    "sourceClosureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nodeId",
          "property",
          "precedence",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "precedence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "value": {}
        }
      }
    }
  }
}
