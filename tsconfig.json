{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src/**/*",
    "integrations/*/src/**/*",
    "tests/**/*",
    "tools/**/*.mjs"
  ]
}
