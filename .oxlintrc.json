{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "tasks/**",
    ".alk/**",
    "**/dist/**",
    "**/coverage/**"
  ],
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/no-console": [
      "error",
      {
        "allow": [
          "info",
          "warn",
          "error"
        ]
      }
    ],
    "eslint/no-eval": "error",
    "eslint/no-implied-eval": "error",
    "eslint/no-new-func": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/compile-core/**",
        "packages/design-tokens/**",
        "packages/source-*/**",
        "packages/target-*/**",
        "packages/web-lowering/**"
      ],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          "fetch",
          "WebSocket",
          "EventSource",
          "XMLHttpRequest",
          "process",
          "performance",
          "Date",
          "crypto"
        ],
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random"
          },
          {
            "object": "globalThis",
            "property": "fetch"
          },
          {
            "object": "globalThis",
            "property": "crypto"
          },
          {
            "object": "globalThis",
            "property": "Date"
          },
          {
            "object": "globalThis",
            "property": "process"
          }
        ],
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:crypto",
                "importNames": [
                  "randomBytes",
                  "randomFill",
                  "randomFillSync",
                  "randomInt",
                  "randomUUID",
                  "webcrypto"
                ]
              },
              {
                "name": "crypto",
                "importNames": [
                  "randomBytes",
                  "randomFill",
                  "randomFillSync",
                  "randomInt",
                  "randomUUID",
                  "webcrypto"
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
